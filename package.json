{
	"name": "n8n-nodes-bridgly",
	"version": "0.1.1",
	"description": "n8n community node for Bridgly: structured public data from social and developer platforms",
	"license": "MIT",
	"homepage": "https://bridgly.app",
	"keywords": [
		"n8n-community-node-package",
		"bridgly",
		"social data",
		"public data",
		"profiles",
		"search"
	],
	"author": {
		"name": "Bridgly",
		"email": "deepak@bridgly.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Bridgly/n8n-nodes-bridgly.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BridglyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Bridgly/Bridgly.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
